# BenchTruth configuration.
# Copy to `.env` and fill in. NEVER commit `.env` -- it is gitignored.

# Which LLM provider fills the project spec.
#   mock = offline, deterministic, zero network. CI and judges use this.
#   meta = the real Meta Model API.
MODEL_PROVIDER=mock

# --- Meta Model API (https://modelapi.meta.com) -------------------------
# Needed only when MODEL_PROVIDER=meta.
META_API_KEY=
META_API_BASE_URL=https://modelapi.meta.com/llama/v1
META_MODEL=muse-spark-1.3

# --- Meta open-weight models (optional) ---------------------------------
# Baseten serves the hackathon's open-weight model id. OpenAI-compatible.
# Used for the spec/explain layer to qualify for the open-weight bonus.
OPENWEIGHT_BASE_URL=
OPENWEIGHT_API_KEY=
OPENWEIGHT_MODEL=meta-models/muse-spark-open-1026

# --- Segmentation (optional, for the physical build-check) --------------
SAM_API_KEY=
SAM_MODEL=sam-3.1

# --- API server ----------------------------------------------------------
HOST=127.0.0.1
PORT=8000
